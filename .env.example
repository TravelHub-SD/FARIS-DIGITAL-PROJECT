# Copy to .env.local and fill in. Never commit real values.
# Local stack: `npx supabase start` prints the URL and keys.
# Hosted (free tier): Supabase dashboard → Project Settings → API Keys.

# Public (inlined into the browser bundle at build time)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_…) or legacy anon key. Safe to expose; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses RLS. Never prefix with NEXT_PUBLIC_, never log it.
# Secret key (sb_secret_…) or legacy service_role key.
SUPABASE_SECRET_KEY=

# Added in later phases (listed here so nothing is a surprise):
# Phase 3: OTP_HMAC_PEPPER, WHATSAPP_DRIVER (dev|meta)
# Phase 7: WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_ACCESS_TOKEN, WHATSAPP_APP_SECRET, WHATSAPP_VERIFY_TOKEN
# Phase 7: CRON_SECRET
