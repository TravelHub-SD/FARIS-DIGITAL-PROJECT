# Copy to .env.local and fill in. Never commit real values.
# Local stack: `npx supabase start` prints the URL and keys.
# Hosted (free tier): Supabase dashboard → Project Settings → API Keys.

# Public (inlined into the browser bundle at build time)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_…) or legacy anon key. Safe to expose; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Show "Continue with Google" only when the Google provider is configured in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Server only. Bypasses RLS. Never prefix with NEXT_PUBLIC_, never log it.
# Secret key (sb_secret_…) or legacy service_role key.
SUPABASE_SECRET_KEY=

# Server only. HMAC key for OTP codes, at least 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates codes that are in flight (5-minute window), nothing else.
OTP_HMAC_PEPPER=

# WhatsApp driver: "dev" prints codes to the local console and is REFUSED
# outside local development (the server will not start). "meta" = Cloud API.
WHATSAPP_DRIVER=dev

# Server only (driver "meta"). Setup: docs/handover.md → WhatsApp.
# System User permanent access token and the sending number's id.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta app secret: verifies X-Hub-Signature-256 on delivery webhooks (≥ 16 chars).
WHATSAPP_APP_SECRET=
# Only while subscribing the webhook in Meta's dashboard, then remove it (≥ 16 chars).
WHATSAPP_VERIFY_TOKEN=
# Bearer secret for /api/whatsapp/dispatch (called by pg_cron via pg_net; same
# value in Supabase Vault as `whatsapp_dispatch_secret`). At least 32 chars.
WHATSAPP_DISPATCH_SECRET=
# Optional: defaults v23.0, https://graph.facebook.com, 10000 (1000–30000).
# WHATSAPP_API_VERSION=v23.0
# WHATSAPP_API_BASE_URL=https://graph.facebook.com
# WHATSAPP_API_TIMEOUT_MS=10000

# Tests only: path to a local Chromium if Playwright's own browsers are not installed.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# Supabase CLI (hosted `supabase config push` only; never needed by the app):
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
